<Window x:Class="Raahro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raahro - Proxy Hotspot"
        Height="760"
        Width="900"
        MinHeight="640"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#0F1419"
        FontFamily="Segoe UI"
        Foreground="#E6EDF3">

    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#238636"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="24,11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="#2EA043">
                            <Border.Effect>
                                <DropShadowEffect Color="#238636" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2EA043"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3FB950"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F6F2E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="Bd" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#DA3633"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="24,11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="#F85149">
                            <Border.Effect>
                                <DropShadowEffect Color="#DA3633" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F85149"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF7B72"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B62324"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                                <Setter TargetName="Bd" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1C2128"/>
                                <Setter Property="Foreground" Value="#E6EDF3"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2F81F7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#161B22"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PortTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0D1117"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="CaretBrush" Value="#2F81F7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2F81F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0D1117"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="240"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0">
                <!-- Gradient background (from SVG) -->
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2F81F7" Offset="0"/>
                        <GradientStop Color="#1E5BB8" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#2F81F7" BlurRadius="18" ShadowDepth="0" Opacity="0.5"/>
                </Border.Effect>

                <Grid ClipToBounds="True">
                    <Grid.Resources>
                        <PathGeometry x:Key="RoadPathGeometry" Figures="M 10,30 C 10,22 30,22 30,10"/>
                    </Grid.Resources>

                    <!-- Ghost road (soft glow halo) -->
                    <Path Stroke="White" StrokeThickness="3.5"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Data="{StaticResource RoadPathGeometry}" Opacity="0.22"/>

                    <!-- Main road -->
                    <Path Stroke="White" StrokeThickness="1.8"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Data="{StaticResource RoadPathGeometry}" Opacity="0.97"/>

                    <!-- Dashed center line (highway hint) -->
                    <Path Stroke="#2F81F7" StrokeThickness="0.4"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              StrokeDashArray="0.6 1"
              Data="{StaticResource RoadPathGeometry}" Opacity="0.5"/>

                    <!-- Animated binary digits flowing along the road -->
                    <Canvas>

                        <!-- Digit 1 (t = 0.0s) -->
                        <TextBlock Text="1" Foreground="White" FontSize="8" FontWeight="Bold" FontFamily="Consolas">
                            <TextBlock.RenderTransform>
                                <TranslateTransform X="10" Y="30"/>
                            </TextBlock.RenderTransform>
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimationUsingPath
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                    PathGeometry="{StaticResource RoadPathGeometry}" Source="X" Duration="0:0:2.5"/>
                                            <DoubleAnimationUsingPath
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                    PathGeometry="{StaticResource RoadPathGeometry}" Source="Y" Duration="0:0:2.5"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>

                        <!-- Digit 0 (t = 0.5s) -->
                        <TextBlock Text="0" Foreground="White" FontSize="8" FontWeight="Bold" FontFamily="Consolas">
                            <TextBlock.RenderTransform>
                                <TranslateTransform X="10" Y="30"/>
                            </TextBlock.RenderTransform>
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard BeginTime="0:0:0.5" RepeatBehavior="Forever">
                                            <DoubleAnimationUsingPath
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                    PathGeometry="{StaticResource RoadPathGeometry}" Source="X" Duration="0:0:2.5"/>
                                            <DoubleAnimationUsingPath
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                    PathGeometry="{StaticResource RoadPathGeometry}" Source="Y" Duration="0:0:2.5"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>

                        <!-- Digit 1 (t = 1.0s) -->
                        <TextBlock Text="1" Foreground="White" FontSize="8" FontWeight="Bold" FontFamily="Consolas">
                            <TextBlock.RenderTransform>
                                <TranslateTransform X="10" Y="30"/>
                            </TextBlock.RenderTransform>
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard BeginTime="0:0:1.0" RepeatBehavior="Forever">
                                            <DoubleAnimationUsingPath
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                    PathGeometry="{StaticResource RoadPathGeometry}" Source="X" Duration="0:0:2.5"/>
                                            <DoubleAnimationUsingPath
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                    PathGeometry="{StaticResource RoadPathGeometry}" Source="Y" Duration="0:0:2.5"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>

                        <!-- Digit 0 (t = 1.5s) -->
                        <TextBlock Text="0" Foreground="White" FontSize="8" FontWeight="Bold" FontFamily="Consolas">
                            <TextBlock.RenderTransform>
                                <TranslateTransform X="10" Y="30"/>
                            </TextBlock.RenderTransform>
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard BeginTime="0:0:1.5" RepeatBehavior="Forever">
                                            <DoubleAnimationUsingPath
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                    PathGeometry="{StaticResource RoadPathGeometry}" Source="X" Duration="0:0:2.5"/>
                                            <DoubleAnimationUsingPath
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                    PathGeometry="{StaticResource RoadPathGeometry}" Source="Y" Duration="0:0:2.5"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>

                        <!-- Digit 1 (t = 2.0s) -->
                        <TextBlock Text="1" Foreground="White" FontSize="8" FontWeight="Bold" FontFamily="Consolas">
                            <TextBlock.RenderTransform>
                                <TranslateTransform X="10" Y="30"/>
                            </TextBlock.RenderTransform>
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard BeginTime="0:0:2.0" RepeatBehavior="Forever">
                                            <DoubleAnimationUsingPath
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                    PathGeometry="{StaticResource RoadPathGeometry}" Source="X" Duration="0:0:2.5"/>
                                            <DoubleAnimationUsingPath
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                    PathGeometry="{StaticResource RoadPathGeometry}" Source="Y" Duration="0:0:2.5"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>

                    </Canvas>
                </Grid>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Raahro"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#E6EDF3"/>
                <TextBlock Text="Proxy Hotspot Manager"
                           FontSize="11"
                           Foreground="#8B949E"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Settings -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="SOCKS5 PORT" Style="{StaticResource SectionTitle}"/>
                    <TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource PortTextBox}"
                             Width="160"
                             HorizontalAlignment="Left"
                             MaxLength="5"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="▶  Start"
                            Command="{Binding StartCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,10,0"/>
                    <Button Content="■  Stop"
                            Command="{Binding StopCommand}"
                            Style="{StaticResource DangerButton}"
                            IsEnabled="{Binding IsRunning}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,14" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0"
                         Width="10" Height="10"
                         VerticalAlignment="Center"
                         Margin="0,0,14,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#8B949E"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Fill" Value="#3FB950"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#3FB950" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#E6EDF3"/>
                    <TextBlock Text="{Binding DetailText}"
                               FontSize="11"
                               Foreground="#8B949E"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Clients -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,0,0,14" Padding="18,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="CONNECTED CLIENTS"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#8B949E"
                               VerticalAlignment="Center"/>
                    <Border DockPanel.Dock="Right"
                            Background="#0D1117"
                            CornerRadius="10"
                            Padding="10,2"
                            BorderBrush="#30363D"
                            BorderThickness="1"
                            HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ConnectedCount}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#2F81F7"/>
                    </Border>
                </DockPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding ConnectedClients}"
                          SelectedItem="{Binding SelectedClient}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#21262D"
                          Background="Transparent"
                          Foreground="#E6EDF3"
                          BorderThickness="0"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#0D1117"
                          RowHeight="32"
                          FontSize="12">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Foreground" Value="#E6EDF3"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1F3A5F"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="115"/>
                        <DataGridTextColumn Header="MAC Address" Binding="{Binding MacAddress}" Width="135"/>
                        <DataGridTextColumn Header="Host" Binding="{Binding HostName}" Width="*"/>
                        <DataGridTextColumn Header="Total DL" Binding="{Binding TotalDownloadText}" Width="90"/>
                        <DataGridTextColumn Header="Total UL" Binding="{Binding TotalUploadText}" Width="90"/>
                        <DataGridTextColumn Header="Speed (DL/UL)" Binding="{Binding SpeedText}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Logs -->
        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="18,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="ACTIVITY LOG"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#8B949E"
                               VerticalAlignment="Center"/>
                    <Button Content="Copy All"
                            Command="{Binding CopyLogsCommand}"
                            Style="{StaticResource GhostButton}"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right"/>
                </DockPanel>

                <Border Grid.Row="1"
                        Background="#0D1117"
                        CornerRadius="6"
                        BorderBrush="#30363D"
                        BorderThickness="1">
                    <TextBox Text="{Binding LogText, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Background="Transparent"
                             Foreground="#A5D6FF"
                             BorderThickness="0"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="12"
                             AcceptsReturn="True"
                             Padding="14,10"
                             CaretBrush="#2F81F7"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>